+    /// History and Settings are no longer tabs; remap stale persisted selections.
+    private static func visibleTab(for tab: AppLifecycleCoordinator.Tab) -> AppLifecycleCoordinator.Tab {
+        switch tab {
+        case .history: return .portfolio
